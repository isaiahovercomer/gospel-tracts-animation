      "cam_to": [
        331,
        371,
        581,
        1032
      ],
      "text": "家庭裏的空氣該是愛。有的人心理反常、寡交，都是因為沒有愛。兒女們將來的情形如何，都是看家庭裏的空氣如何。",
      "text_pos": "bottom-right",
      "sprites": [
        {
          "region": "foliage_decor_left_top",
          "x": 0.86,
          "y": 0.09,
          "w": 0.15,
          "motion": "sway"
        },
        {
          "region": "house_illustration_right",
          "x": 0.14,
          "y": 0.61,
          "w": 0.16,
          "motion": "float"
        }
      ],
      "start": 3.0,
